{
    "name": "timmit/console",
    "description": "Lightweight utility and helper classes for CLI applications",
    "keywords": [
        "cli",
        "console"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nofriandi Ramenta",
            "email": "nramenta@gmail.com",
            "role": "author of original source"
        },
        {
            "name": "Tim Schoondergang",
            "email": "Tim.Schoondergang@TiMMiT.nl",
            "homepage": "http://www.TiMMiT.nl"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-pcntl": "*",
        "ext-posix": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "TiMMiT\\": "src/TiMMiT/"
        }
    }
}
